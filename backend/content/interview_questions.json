      ]
    },
    {
      "id": "academic-subject",
      "text": "Which subject from your degree would you like to discuss, and why?",
      "topic": "Academic understanding",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "academic-subject-2",
      "text": "Can you explain one idea from that subject using a practical example?",
      "topic": "Academic understanding",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "academic-subject-3",
      "text": "What assumptions does that explanation depend on, and when might it fail?",
      "topic": "Academic understanding",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "academic-project",
      "text": "Walk me through a project or assignment from your studies. What was your part?",
      "topic": "Academic projects",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "academic-project-2",
      "text": "Why did you choose that method or approach?",
      "topic": "Academic projects",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "academic-project-3",
      "text": "What evidence would make you reconsider your conclusion?",
      "topic": "Academic projects",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "internship",
      "text": "Tell me about an internship, volunteering role or responsibility outside class.",
      "topic": "Early experience",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "internship-2",
      "text": "What did you find harder than you expected, and how did you respond?",
      "topic": "Early experience",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "internship-3",
      "text": "What would you change if you took on that responsibility again?",
      "topic": "Early experience",
      "routes": [
        "cat"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "work-decision",
      "text": "Tell me about a decision at work for which you were personally responsible.",
      "topic": "Workplace judgment",
      "routes": [
        "experienced"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "work-decision-2",
      "text": "What alternative did you reject and what was the trade-off?",
      "topic": "Workplace judgment",
      "routes": [
        "experienced"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "work-decision-3",
      "text": "What would someone who disagreed with you say you overlooked?",
      "topic": "Workplace judgment",
      "routes": [
        "experienced"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "work-disagreement",
      "text": "Describe a disagreement with a colleague or manager. What was at stake?",
      "topic": "Working with others",
      "routes": [
        "experienced"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "work-disagreement-2",
      "text": "How did you try to understand their position?",
      "topic": "Working with others",
      "routes": [
        "experienced"
      ],
      "sources": [
        "practice-editorial"
      ]
    },
    {
      "id": "work-disagreement-3",
      "text": "What did you change in your own approach as a result?",
      "topic": "Working with others",
      "routes": [
        "experienced"
      ],
      "sources": [
        "practice-editorial"
      ]
    }
