# Pilot environment template
# Copy to a secure, non-committed location and fill real values.

APP_ENV=pilot
MOCK_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Required: 32+ random chars. Example command:
# openssl rand -hex 32
SECRET_KEY=replace-with-64-hex-chars-or-long-random-string

# Default token windows are fine for pilot unless you want tighter sessions.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database. Use managed PostgreSQL (e.g. Neon) for anything holding real applicant data.
# Two connections, two roles:
# - MIGRATION_DATABASE_URL: schema owner, used only by `python scripts/db_migrate.py`
#   during a release (Neon: the DIRECT, non-pooled endpoint).
# - DATABASE_URL: restricted runtime role created by `python scripts/db_roles.py`
#   (DML only, cannot alter schema). Neon: the POOLED endpoint.
# The API refuses to start if the schema is not at this release's migration head.
MIGRATION_DATABASE_URL=postgresql://owner:owner-password@your-direct-host/neondb?sslmode=require
DATABASE_URL=postgresql://app_runtime:runtime-password@your-pooled-host/neondb?sslmode=require
# Per-process pool (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# Required in pilot mode
ADMIN_EMAILS=you@yourdomain.com

# Required in pilot mode for real email verification/password reset/reminders
SMTP_HOST=smtp.yourprovider.com
# 587 uses STARTTLS; 465 uses implicit TLS.
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com

# Public HTTPS origin of the frontend. Verification and reset emails link here
# (e.g. https://app.yourdomain.com/auth/reset-password#token=...). Origin only, no path.
PUBLIC_APP_URL=https://app.yourdomain.com

# Frontend domain(s) allowed to call backend
CORS_ORIGINS=https://app.yourdomain.com
# Optional regex for preview/frontends (example for Cloudflare Pages previews):
# CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\\.)?your-pages-project\\.pages\\.dev$

# Keep empty/false in pilot
EXPOSE_DEV_AUTH_TOKENS=

# Optional
GOOGLE_CLIENT_ID=
